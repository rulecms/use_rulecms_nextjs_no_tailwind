# App token — never commit real values. Copy this file to `.env.local`.
# Client-side widget fetch (browser). Prefer the server token for SSR pages.
NEXT_PUBLIC_RULECMS_TOKEN=
NEXT_PUBLIC_RULECMS_ENDPOINT=https://rulecms.com

# Server pre-fetched pages. Do not prefix this token with NEXT_PUBLIC_.
RULECMS_TOKEN=
RULECMS_ENDPOINT=https://rulecms.com

# Widget 1 published key (`{environmentId}---widget-…`).
NEXT_PUBLIC_RULECMS_WIDGET_1_PUBLISHED_KEY=
RULECMS_WIDGET_1_PUBLISHED_KEY=
